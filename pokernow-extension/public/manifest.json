{
  "manifest_version": 3,
  "name": "PokerNow Bot",
  "description": "Base Level Extension",
  "version": "1.15.8",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Icons/icon16.png",
    "32": "Icons/icon32.png",
    "48": "Icons/icon48.png",
    "128": "Icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.pokernow.club/*", "https://www.pokernow.com/*"],
    "js": ["main.js"]
  }],
  "permissions": [
    "storage", "unlimitedStorage", "scripting", "activeTab"
  ],
  "host_permissions": [
    "https://www.pokernow.club/*",
    "https://www.pokernow.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
