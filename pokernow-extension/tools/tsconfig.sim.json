  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"],
    "rootDir": "../src",
    "outDir": ".build-sim"
  },
  "files": [
    "../src/types.d.ts",
    "../src/sim/run.ts",
    "../src/sim/tune.ts",
    "../src/sim/evolve.ts",
    "../src/sim/cash.ts"
  ]
}
